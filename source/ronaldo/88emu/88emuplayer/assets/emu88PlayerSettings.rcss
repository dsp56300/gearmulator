body {
	width: 690dp;
	height: 410dp;
	background-color: #252b30;
	color: #dce2e6;
	font-family: Roboto;
	font-size: 13dp;
	font-weight: 400;
	overflow: hidden;
}

.hardwareSettingsRoot {
	display: flex;
	flex-direction: row;
	width: 100%;
	height: 100%;
	background-color: #252b30;
}

.hardwareSettingsSidebar {
	display: flex;
	flex-direction: column;
	flex: 0 0 122dp;
	box-sizing: border-box;
	gap: 4dp;
	padding: 14dp 10dp;
	background-color: #1c2226;
	border-right: 1dp #3b444b;
}

.hardwareSettingsNavButton {
	width: 101dp;
	height: 31dp;
	box-sizing: border-box;
	padding: 7dp 9dp;
	background-color: transparent;
	border: 1dp transparent;
	border-radius: 4dp;
	color: #b8c0c5;
	font-size: 12dp;
	text-align: left;
	cursor: pointer;
}

.hardwareSettingsNavButton:hover {
	background-color: #293137;
	color: #ffffff;
}

.hardwareSettingsNavButton:checked {
	background-color: #343f46;
	border: 1dp #56636c;
	color: #ffffff;
}

.hardwareSettingsPages {
	flex: 1 1 auto;
	box-sizing: border-box;
	padding: 15dp 17dp;
	overflow: hidden;
}

.hardwareSettingsPage {
	display: block;
	width: 100%;
	height: 100%;
}

.hardwareSettingsPageHeader {
	display: block;
	height: 36dp;
	border-bottom: 1dp #3b444b;
}

.hardwareSettingsPageHeader h1 {
	display: block;
	margin: 0dp 0dp 3dp 0dp;
	padding: 0dp;
	color: #f3f5f6;
	font-size: 19dp;
	font-weight: 600;
	text-align: left;
}

.hardwareSettingsSectionLabel {
	display: block;
	margin: 18dp 0dp 7dp 0dp;
	color: #aeb8be;
	font-size: 11dp;
	font-weight: 600;
}

.hardwareSettingsPages .button {
	min-width: 55dp;
	height: 26dp;
	box-sizing: border-box;
	padding: 5dp 9dp;
	border: 1dp #515c64;
	border-radius: 3dp;
	background-color: #333c42;
	box-shadow: none;
	color: #e4e8ea;
	font-size: 11dp;
	line-height: 13dp;
	cursor: pointer;
}

.hardwareSettingsPages .button:hover {
	background-color: #3d484f;
	border-color: #68747d;
}

.hardwareSettingsPages .button:active {
	background-color: #2b3338;
	box-shadow: none;
}

.hardwareSkinTable {
	width: 100%;
	box-sizing: border-box;
	border: 1dp #414b52;
	border-radius: 3dp;
}

.hardwareSkinHeader {
	height: 27dp;
	background-color: #20262a;
	color: #88949c;
	font-size: 10dp;
	font-weight: 600;
}

.hardwareSkinRow {
	height: 36dp;
	background-color: #2c3338;
	border-top: 1dp #414b52;
}

.hardwareSkinRow:current {
	background-color: #354148;
}

.hardwareSkinTable td {
	box-sizing: border-box;
	padding: 5dp 7dp;
	vertical-align: middle;
}

.hardwareSkinName { width: 48%; }
.hardwareSkinType { width: 22%; color: #9ba6ad; }
.hardwareSkinAction { width: 30%; }

.hardwareSkinActions {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	gap: 5dp;
}

.hardwareSkinFooter {
	display: block;
	padding-top: 16dp;
}

.hardwareChoiceGrid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 6dp;
}

.hardwareChoiceGrid .hardwareChoice {
	width: 91dp;
}

.hardwareWideChoice {
	width: 310dp;
}

.hardwareChoice {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 29dp;
	box-sizing: border-box;
	gap: 7dp;
	padding: 5dp 7dp;
	border: 1dp #414b52;
	border-radius: 3dp;
	background-color: #2b3237;
	color: #c9d0d4;
	cursor: pointer;
}

.hardwareChoice:hover {
	background-color: #343d43;
}

.settings-checkbox {
	display: block;
	position: relative;
	width: 12dp;
	min-width: 12dp;
	height: 12dp;
	padding: 0dp;
	border: 1dp #66737c;
	border-radius: 2dp;
	background-color: #171c1f;
}

.settings-checkbox:checked {
	decorator: image(check.png fill);
	background-color: #52616a;
	image-color: #ffffff;
}

/* Two fields to a row: each is half the page's 534dp content width, less the gap. */
.hardwareFormGrid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 7dp 10dp;
}

/* One field to a row, with room for its label on one line - as wide as a wide choice. */
.hardwareFormList {
	flex-direction: column;
}

.hardwareField {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	width: 261dp;
	height: 29dp;
	color: #aeb8be;
	font-size: 13dp;
}

.hardwareFormList .hardwareField {
	width: 310dp;
}

/* Every control one width; flex would otherwise shrink the ones beside a long label. */
.hardwareField combo, .hardwareField input {
	flex: 0 0 132dp;
	width: 132dp;
	height: 26dp;
	box-sizing: border-box;
	border: 1dp #515c64;
	border-radius: 3dp;
	background-color: #1f2529;
	color: #eef1f2;
	font-size: 13dp;
}

.hardwareField combo {
	padding: 4dp 16dp 4dp 6dp;
	/* the default paints the arrow over the whole padding box, which makes it as tall as the field */
	decorator: image(arrow_drop_down.png contain right) content-box;
}

.hardwareField input {
	padding: 4dp 6dp;
}

/* A long entry, such as an output device name, is cut off before the arrow. */
.hardwareField combotext {
	display: block;
	height: 100%;
	margin-right: 14dp;
	overflow: hidden;
	white-space: nowrap;
	line-height: 14dp;
}

/* A file path and its Open button: the path takes whatever width the button leaves. */
.hardwareFileRow {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
}

.hardwareFileRow input {
	flex: 1 1 auto;
	height: 26dp;
	box-sizing: border-box;
	padding: 4dp 6dp;
	border: 1dp #515c64;
	border-radius: 3dp;
	background-color: #1f2529;
	color: #eef1f2;
	font-size: 13dp;
}

/* The controls under the audio device grid would otherwise touch its last row. */
#audioControlPanelRow, #btOutputLimiter {
	margin-top: 12dp;
}

.hardwareInlineChoices {
	display: flex;
	flex-direction: row;
	gap: 6dp;
}

.hardwareInlineChoices .hardwareChoice {
	flex: 1 1 auto;
}

.hardwareMidiRow {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
	margin-top: 12dp;
}

.hardwareMidiOutput {
	width: 210dp;
}

.hardwarePortMidi {
	flex: 1 1 auto;
}

.hardwareInputLabel {
	margin: 9dp 0dp 5dp 0dp;
	color: #8e9aa2;
	font-size: 10dp;
}

/* Sized to fill the page: header, output row, this list and the note below add up to the
   window height. One dense row per device, the names can be long. */
.hardwareMidiInputList {
	display: flex;
	flex-direction: column;
	gap: 1dp;
	height: 240dp;
	box-sizing: border-box;
	padding: 3dp;
	border: 1dp #414b52;
	border-radius: 3dp;
	background-color: #20262a;
	overflow-y: auto;
}

/* One row per input: its name, then a toggle per part group. No group lit: the input is closed. */
.hardwareMidiInput {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 22dp;
	min-height: 22dp;
	box-sizing: border-box;
	padding: 2dp 3dp 2dp 6dp;
	gap: 3dp;
	border-radius: 2dp;
	color: #c9d0d4;
	font-size: 11dp;
}

.hardwareMidiInput:hover {
	background-color: #2e373d;
}

.hardwareMidiInputName {
	flex: 1 1 auto;
	overflow: hidden;
	white-space: nowrap;
}

/* The four part-group toggles as one segmented control: flush, sharing single dividers - each
   segment draws only its left edge and the last one also closes the right - and rounded only on
   the outside. */
.hardwareMidiGroups {
	display: flex;
	flex-direction: row;
}

.hardwareMidiGroup {
	display: block;
	width: 19dp;
	min-width: 19dp;
	height: 17dp;
	box-sizing: border-box;
	padding: 0dp;
	border-width: 1dp 0dp 1dp 1dp;
	border-color: #66737c;
	border-radius: 0dp;
	background-color: #171c1f;
	color: #8e9aa2;
	font-size: 10dp;
	line-height: 14dp;
	text-align: center;
	cursor: pointer;
}

.hardwareMidiGroup:first-child {
	border-radius: 2dp 0dp 0dp 2dp;
}

.hardwareMidiGroup:last-child {
	border-right-width: 1dp;
	border-radius: 0dp 2dp 2dp 0dp;
}

.hardwareMidiGroup:hover {
	background-color: #2b3237;
}

.hardwareMidiGroup:checked {
	background-color: #52616a;
	color: #ffffff;
}

.hardwareMidiGroup:checked:hover {
	background-color: #5d6e78;
}

/* A group the current device doesn't have: its messages are dropped. */
.hardwareMidiGroup.unavailable {
	opacity: 0.4;
}

.hardwareMidiNote {
	margin-top: 6dp;
	color: #77838b;
	font-size: 10dp;
	line-height: 13dp;
}

.hardwareMidiInputEmpty {
	padding: 4dp 2dp;
	color: #77838b;
	font-size: 10dp;
}

/* Wide choices stacked one per row; without the gap their boxes would touch. */
.hardwareChoiceList {
	display: flex;
	flex-direction: column;
	gap: 8dp;
}

scrollbarvertical {
	width: 8dp;
}

scrollbarvertical sliderbar {
	min-height: 12dp;
	border-radius: 4dp;
	background-color: #59656d;
}
