/* The window has a fixed size, and the pages and lists are sized out of it: a list that leaves its height to the
   flex layout grows with its entries and never scrolls. 720 = top bar 46 + page 648 + status bar 26; a page is
   1096 x 624 inside its padding, 722 for the main pane, 12 between, 362 for the side pane. */
body {
	width: 1120dp;
	height: 720dp;
	background-color: #252b30;
	color: #dce2e6;
	font-family: Roboto;
	font-size: 14dp;
	font-weight: 400;
	overflow: hidden;
}

/* RmlUi has no stylesheet of its own: an element left without a display is inline, and an inline scroll container
   paints its background over the block children it scrolls. */
div {
	display: block;
}

.peRoot {
	display: block;
	position: relative;
	width: 100%;
	height: 100%;
}

/* Mixer, the SC-8850's group switch, the part tabs, then the menu of the transfers on the right. The tabs stand on the bar's
   bottom edge, over its border, and the selected one opens into the page below. */
.peTopBar {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	box-sizing: border-box;
	height: 46dp;
	padding: 0dp 12dp;
	background-color: #1c2226;
	border-bottom: 1dp #3b444b;
}

.peTab, .pePartTab {
	display: block;
	box-sizing: border-box;
	height: 34dp;
	margin-bottom: -1dp;
	border: 1dp #3b444b;
	border-radius: 5dp 5dp 0dp 0dp;
	background-color: #222a2e;
	color: #aab3b9;
	font-size: 13dp;
	line-height: 32dp;
	text-align: center;
	cursor: pointer;
}

.peTab:hover, .pePartTab:hover {
	background-color: #2c353a;
	color: #ffffff;
}

.peTab:checked, .pePartTab:checked {
	border-color: #59656d;
	border-bottom-color: #252b30;
	background-color: #252b30;
	color: #ffffff;
	font-weight: 600;
}

.peTabMixer {
	width: 88dp;
}

/* White in the file, tinted here to follow the tab's text */
.peTabIcon {
	width: 13dp;
	height: 13dp;
	margin: -2dp 6dp 0dp 0dp;
	vertical-align: middle;
	image-color: #aab3b9;
}

.peTab:hover .peTabIcon, .peTab:checked .peTabIcon {
	image-color: #ffffff;
}

/* Between the mixer and the parts. It, the group switch and the menu button line up with the tab labels. */
.peSeparator {
	align-self: flex-end;
	width: 1dp;
	height: 24dp;
	margin: 0dp 10dp 4dp 10dp;
	background-color: #4a555c;
}

/* The SC-8850's pairs of part groups as one segmented control: flush, sharing single dividers - each segment draws its left edge and the
   last one also closes the right - and rounded on the outside only. */
.peGroups {
	display: flex;
	flex-direction: row;
	align-self: flex-end;
	margin: 0dp 10dp 2dp 0dp;
}

.peGroup {
	display: block;
	box-sizing: border-box;
	width: 38dp;
	height: 28dp;
	border: 1dp #414b52;
	border-width: 1dp 0dp 1dp 1dp;
	background-color: #2b3237;
	color: #b8c0c5;
	font-size: 13dp;
	font-weight: 600;
	line-height: 26dp;
	text-align: center;
	cursor: pointer;
}

.peGroup:first-child {
	border-radius: 4dp 0dp 0dp 4dp;
}

.peGroup:last-child {
	border-right-width: 1dp;
	border-radius: 0dp 4dp 4dp 0dp;
}

.peGroup:hover {
	background-color: #343d43;
	color: #ffffff;
}

.peGroup:checked {
	background-color: #52616a;
	border-color: #68747d;
	color: #ffffff;
}

/* Sixteen tabs, or the 32 of two part groups, share what the group switch and the buttons leave. */
.pePartTabs {
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	gap: 2dp;
}

.pePartTab {
	flex: 1 1 0dp;
	min-width: 24dp;
}

.pePartTabs.twoGroups {
	gap: 1dp;
}

.pePartTabs.twoGroups .pePartTab {
	min-width: 0dp;
	font-size: 12dp;
}

/* The second group stands apart from the first */
.pePartTab.groupStart {
	margin-left: 6dp;
}

/* A drum part's tab says so. */
.pePartTab.drum {
	color: #e8a35c;
}

.peActionsMenu {
	display: block;
	align-self: flex-end;
	box-sizing: border-box;
	width: 34dp;
	height: 28dp;
	margin: 0dp 0dp 2dp 12dp;
	border: 1dp #515c64;
	border-radius: 4dp;
	background-color: #333c42;
	text-align: center;
	cursor: pointer;
}

.peActionsMenu:hover {
	background-color: #3d484f;
	border-color: #68747d;
}

.peActionsMenu:checked {
	background-color: #52616a;
	border-color: #68747d;
}

.peActionsMenu:disabled {
	opacity: 0.4;
	cursor: auto;
}

/* The panel the menu button opens, below its right end */
.peActionsPanel {
	position: absolute;
	top: 43dp;
	right: 12dp;
	z-index: 20;
	box-sizing: border-box;
	width: 300dp;
	padding: 4dp 0dp;
	border: 1dp #59656d;
	border-radius: 5dp;
	background-color: #2b3237;
}

.peActionsRow {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
	height: 30dp;
	padding: 0dp 12dp 0dp 6dp;
	color: #e4e8ea;
	font-size: 13dp;
	cursor: pointer;
}

.peActionsRow:hover {
	background-color: #3d484f;
}

.peActionsRow.disabled {
	color: #6b767d;
	cursor: auto;
}

.peActionsRow.disabled:hover {
	background-color: #2b3237;
}

.peActionsLabel {
	flex: 1 1 auto;
	height: 30dp;
	line-height: 30dp;
	white-space: nowrap;
}

/* A MIDI file's grip: dragged out of the window, it drops the file on a host's track */
.peGrip, .peGripSpace {
	flex: 0 0 22dp;
	width: 22dp;
	height: 22dp;
}

.peGrip {
	border-radius: 3dp;
	text-align: center;
	cursor: move;
	drag: clone;
}

.peGrip:hover {
	background-color: #52616a;
}

.peActionsRow.disabled .peGrip {
	drag: none;
	cursor: auto;
	opacity: 0.4;
}

.peActionsRow.disabled .peGrip:hover {
	background-color: #2b3237;
}

/* White in the file, tinted here */
.peGripIcon {
	width: 14dp;
	height: 14dp;
	margin-top: 4dp;
	image-color: #aab3b9;
}

.peGrip:hover .peGripIcon {
	image-color: #ffffff;
}

.peActionsSeparator {
	height: 1dp;
	margin: 4dp 8dp;
	background-color: #414b52;
}

/* White in the file, tinted here */
.peActionsIcon {
	width: 16dp;
	height: 16dp;
	margin-top: 5dp;
	image-color: #dce2e6;
}

.peActionsMenu:hover .peActionsIcon {
	image-color: #ffffff;
}

/* Two panes side by side: two thirds on the left, the third on the right */
.pePage {
	display: flex;
	flex-direction: row;
	gap: 12dp;
	box-sizing: border-box;
	height: 648dp;
	padding: 12dp;
	overflow: hidden;
}

.peMainPane {
	flex: 0 0 722dp;
	width: 722dp;
	height: 624dp;
}

.peSidePane {
	flex: 0 0 362dp;
	width: 362dp;
	height: 624dp;
}

.pePaneTitle {
	height: 26dp;
	color: #88949c;
	font-size: 12dp;
	font-weight: 600;
	line-height: 22dp;
}

/* ---- Mixer: one row per part, every group, scrolled. 624 = header 26 + rows 598. The header columns have the
   rows' widths, and the rows always show their scrollbar so that the two line up. */

.peMixerHeader, .peMixRow {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
}

.peMixerHeader {
	height: 26dp;
	padding: 0dp 20dp 0dp 10dp;
	color: #88949c;
	font-size: 12dp;
	font-weight: 600;
}

.peMixHeadSoloMute { flex: 0 0 46dp; width: 46dp; }
.peMixHeadName { display: flex; flex-direction: row; flex: 1 1 auto; gap: 10dp; }
.peMixHeadPart { flex: 0 0 38dp; width: 38dp; }
.peMixHeadTone { flex: 1 1 auto; }
.peMixHeadVolume { flex: 0 0 220dp; width: 220dp; }
.peMixHeadPan { flex: 0 0 150dp; width: 150dp; margin-left: 24dp; }

.peMixerRows {
	box-sizing: border-box;
	height: 598dp;
	padding: 3dp;
	border: 1dp #414b52;
	border-radius: 4dp;
	background-color: #20262a;
	overflow-y: scroll;
}

.peMixGroupHeading {
	display: block;
	height: 26dp;
	padding: 0dp 6dp;
	color: #aeb8be;
	font-size: 13dp;
	font-weight: 600;
	line-height: 26dp;
}

.peMixRow {
	height: 28dp;
	padding: 0dp 6dp;
	border-radius: 3dp;
	color: #c9d0d4;
	font-size: 13dp;
}

.peMixRow:hover {
	background-color: #2a3237;
}

.peMixSoloMute {
	display: flex;
	flex-direction: row;
	flex: 0 0 46dp;
	width: 46dp;
	gap: 4dp;
}

.peMixSolo, .peMixMute {
	display: block;
	box-sizing: border-box;
	width: 21dp;
	height: 20dp;
	border: 1dp #515c64;
	border-radius: 3dp;
	background-color: #2b3237;
	color: #8e9aa2;
	font-size: 11dp;
	font-weight: 600;
	line-height: 18dp;
	text-align: center;
	cursor: pointer;
}

.peMixSolo:hover, .peMixMute:hover {
	background-color: #343d43;
	color: #ffffff;
}

.peMixSolo:checked {
	background-color: #d4b02a;
	border-color: #e8c84a;
	color: #17181c;
}

.peMixMute:checked {
	background-color: #c0453a;
	border-color: #d8655a;
	color: #ffffff;
}

/* Part number and instrument are one target: either opens the part */
.peMixName {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 auto;
	gap: 10dp;
	height: 100%;
	cursor: pointer;
}

.peMixPart {
	flex: 0 0 38dp;
	width: 38dp;
	color: #ffffff;
	font-weight: 600;
}

.peMixTone {
	flex: 1 1 auto;
	overflow: hidden;
	white-space: nowrap;
}

.peMixName:hover .peMixPart, .peMixName:hover .peMixTone {
	color: #e8a35c;
}

.peMixRow.drum .peMixTone {
	color: #e8a35c;
}

/* A part the mute or the solo silences */
.peMixRow.silenced .peMixPart, .peMixRow.silenced .peMixTone, .peMixRow.silenced .peMixValue {
	color: #66737c;
}

.peMixVolume, .peMixPan {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
}

.peMixVolume {
	flex: 0 0 220dp;
	width: 220dp;
}

.peMixPan {
	flex: 0 0 150dp;
	width: 150dp;
	margin-left: 24dp;
}

.peMixValue {
	flex: 0 0 32dp;
	width: 32dp;
	color: #aeb8be;
	text-align: right;
}

.peMixPan .peMixValue {
	flex: 0 0 38dp;
	width: 38dp;
}

input.peSlider {
	flex: 1 1 auto;
	height: 16dp;
}

input.peSlider slidertrack {
	margin-top: 6dp;
	height: 4dp;
	border-radius: 2dp;
	background-color: #3b444b;
}

input.peSlider sliderbar {
	width: 10dp;
	height: 16dp;
	border-radius: 3dp;
	background-color: #8e9aa2;
}

input.peSlider sliderbar:hover, input.peSlider sliderbar:active {
	background-color: #ffffff;
}

input.peSlider sliderarrowdec, input.peSlider sliderarrowinc {
	width: 0dp;
	height: 0dp;
}

/* ---- Parameters: sections of rows, a label, then a slider with its value or a choice. The part's in two
   columns, the system and effects in one. */

.peControls {
	box-sizing: border-box;
	padding: 2dp 8dp 6dp 8dp;
	border: 1dp #414b52;
	border-radius: 4dp;
	background-color: #20262a;
	overflow-y: auto;
}

.peGlobals {
	height: 598dp;
}

.pePartControls {
	height: 588dp;
}

.peColumns {
	display: flex;
	flex-direction: row;
	gap: 18dp;
}

.peColumn {
	flex: 1 1 0dp;
}

/* 24 a row: the part page's left column, three sections and twenty rows, fits without scrolling */
.peSection {
	margin-bottom: 4dp;
}

.peSectionTitle {
	height: 26dp;
	margin-bottom: 2dp;
	border-bottom: 1dp #343d43;
	color: #e8a35c;
	font-size: 13dp;
	font-weight: 600;
	line-height: 26dp;
}

.peRow {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	height: 24dp;
	padding: 0dp 4dp;
	border-radius: 3dp;
}

.peRow:hover {
	background-color: #262e33;
}

.peRowLabel {
	flex: 0 0 118dp;
	width: 118dp;
	color: #c9d0d4;
	font-size: 13dp;
	white-space: nowrap;
	overflow: hidden;
}

.peRowValue {
	flex: 0 0 64dp;
	width: 64dp;
	color: #aeb8be;
	font-size: 13dp;
	text-align: right;
	white-space: nowrap;
}

/* A parameter only a channel message sets: the data requests cannot read it back */
.peRow.channelOnly .peRowLabel {
	color: #9aa5ac;
	font-style: italic;
}

combo.peCombo, combo.peMapSelect {
	display: block;
	box-sizing: border-box;
	padding: 0dp 24dp 0dp 8dp;
	border: 1dp #515c64;
	border-radius: 4dp;
	background-color: #2b3237;
	color: #e4e8ea;
	font-size: 13dp;
	white-space: nowrap;
	overflow: hidden;
	cursor: pointer;
	decorator: image(arrow_drop_down.png contain right);
}

combo.peCombo {
	flex: 1 1 auto;
	width: auto;
	height: 22dp;
	line-height: 20dp;
}

combo.peCombo:hover, combo.peMapSelect:hover {
	background-color: #343d43;
	border-color: #68747d;
}

combo.peMapSelect combotext, combo.peCombo combotext {
	display: block;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

/* ---- Part: the title and what the part is, the parameters; on the right the tone map and the filter, then one
   list of the instruments, each with its variations under it. 624 = header 36 + controls 588, and on the right
   map row 30 + 8 + label 22 + list 564. */

.pePartHeader {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	gap: 12dp;
	height: 36dp;
}

.pePartTitle {
	color: #f3f5f6;
	font-size: 21dp;
	font-weight: 600;
}

.pePartInfo {
	color: #aeb8be;
	font-size: 13dp;
	white-space: nowrap;
	overflow: hidden;
}

.peMapRow {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 30dp;
	margin-bottom: 8dp;
	gap: 10dp;
}

/* The map and the filter share the row; a board with one map leaves it to the filter */
combo.peMapSelect {
	flex: 1 1 0dp;
	width: 10dp;
	height: 28dp;
	line-height: 26dp;
}

.peFilter {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 0dp;
	width: 10dp;
	gap: 6dp;
}

.peFilterLabel {
	color: #88949c;
	font-size: 13dp;
}

input.peFilterInput {
	flex: 1 1 0dp;
	width: 10dp;
	height: 28dp;
	box-sizing: border-box;
	padding: 5dp 7dp;
	border: 1dp #515c64;
	border-radius: 4dp;
	background-color: #1f2529;
	color: #eef1f2;
	font-size: 13dp;
}

.peListLabel {
	display: block;
	height: 22dp;
	color: #88949c;
	font-size: 12dp;
	font-weight: 600;
}

.peList {
	box-sizing: border-box;
	height: 564dp;
	padding: 3dp;
	border: 1dp #414b52;
	border-radius: 4dp;
	background-color: #20262a;
	overflow-y: auto;
}

/* A whole row is one target */
.peItem {
	display: block;
	width: 100%;
	box-sizing: border-box;
	height: 23dp;
	padding: 0dp 6dp;
	border-radius: 3dp;
	color: #c9d0d4;
	font-size: 13dp;
	line-height: 23dp;
	white-space: nowrap;
	overflow: hidden;
	cursor: pointer;
}

.peItem:hover {
	background-color: #2e373d;
}

/* The instrument whose variation the part plays */
.peItem.current {
	color: #ffffff;
}

.peItem.selected {
	background-color: #52616a;
	color: #ffffff;
}

.peItem.selected:hover {
	background-color: #5d6e78;
}

.peItem.context {
	color: #77838b;
}

/* Variations sit under their instrument */
.peVariation {
	padding-left: 38dp;
}

.peItemNumber {
	display: inline-block;
	width: 34dp;
	color: #88949c;
}

.peItem.selected .peItemNumber {
	color: #dce2e6;
}

.peListEmpty {
	display: block;
	padding: 4dp 6dp;
	color: #77838b;
	font-size: 13dp;
}

.peStatusBar {
	box-sizing: border-box;
	height: 26dp;
	padding: 0dp 12dp;
	background-color: #1c2226;
	border-top: 1dp #3b444b;
}

.peStatus {
	color: #8e9aa2;
	font-size: 12dp;
	line-height: 25dp;
	white-space: nowrap;
	overflow: hidden;
}

.peStatus.error {
	color: #e8a35c;
}

scrollbarvertical {
	width: 8dp;
}

scrollbarvertical sliderbar {
	min-height: 12dp;
	border-radius: 4dp;
	background-color: #59656d;
}
