+	void JitBlockChain::invalidateLoopEnd(const TWord _end)
+	{
+		// Called after generated code has returned. A newly discovered boundary
+		// changes the block covering its final word, including chained parents.
+		destroy(_end - 1);
+		// destroy() retains single-op variants. Their opcode key does not encode
+		// loop boundaries, so evict variants that could cover this word as well.
+		for(TWord pc = _end > 1 ? _end - 2 : 0; pc < _end && pc < m_jitCache.size(); ++pc)
+		{
+			auto& entry = m_jitCache[pc];
+			if(!entry.singleOpCache) continue;
+			for(auto it = entry.singleOpCache->begin(); it != entry.singleOpCache->end();)
+			{
+				if(pc + it->second->getPMemSize() >= _end)
+				{
+					release(it->second);
+					entry.singleOpCache->erase(it++);
+				}
+				else ++it;
+			}
+		}
+	}
