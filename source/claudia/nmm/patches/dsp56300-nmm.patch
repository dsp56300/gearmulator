+	// Never cross labels, calls, arbitrary instructions, or W/X aliases written
+	// by the select. This occurs in bridged-memory selection plus bounds checks.
+	size_t JitOptimizer::redundantComparisons() const
+	{
+		size_t removed=0;
+#ifdef HAVE_ARM64
+		for(auto* node=m_asm.firstNode();node;node=node->next())
+		{
+			if(!node->isInst()) continue;
+			auto* first=node->as<asmjit::InstNode>();
+			if(first->id()!=Inst::kIdCmp || first->opCount()!=2) continue;
+			auto* middle=node->next();
+			if(!middle || !middle->isInst()) continue;
+			auto* select=middle->as<asmjit::InstNode>();
+			if(select->id()!=Inst::kIdCsel || !select->op(0).isReg()) continue;
+			auto* last=middle->next();
+			if(!last || !last->isInst()) continue;
+			auto* second=last->as<asmjit::InstNode>();
+			if(second->id()!=Inst::kIdCmp || second->opCount()!=2) continue;
+			bool safe=true;
+			for(unsigned i=0;i<2;++i)
+			{
+				const auto& operand=first->op(i);
+				if(operand!=second->op(i) || (!operand.isReg() && !operand.isImm())) {safe=false;break;}
+				if(operand.isReg() && operand.as<asmjit::BaseReg>().id()==select->op(0).as<asmjit::BaseReg>().id()) {safe=false;break;}
+			}
+			if(safe) {m_asm.removeNode(last);++removed;}
+		}
+#endif
+		return removed;
+	}
