+	void JitOptimizerTests::testRedundantComparisons()
+	{
+#ifdef HAVE_ARM64
+		using namespace asmjit::a64;
+		// Positive case, written operand, changed immediate, changed width,
+		// intervening label, and intervening flag write.
+		for(unsigned variant=0;variant<6;++variant)
+		{
+			using Func=uint64_t(*)(uint64_t,uint64_t);
+			Func funcs[2]{};
+			for(unsigned optimized=0;optimized<2;++optimized)
+			{
+				asmjit::CodeHolder code;code.init(m_rt.environment());JitEmitter e(&code);
+				e.cmp(w0,asmjit::Imm(512));
+				e.csel(variant==1?x0:x2,x0,x1,asmjit::arm::CondCode::kGE);
+				if(variant==4) e.bind(e.newLabel());
+				if(variant==5) e.adds(w3,w1,asmjit::Imm(1));
+				if(variant==3) e.cmp(x0,asmjit::Imm(512));
+				else e.cmp(w0,asmjit::Imm(variant==2?513:512));
+				e.cset(w3,asmjit::arm::CondCode::kGE);
+				e.add(x0,variant==1?x0:x2,x3);e.ret();
+				if(optimized)
+				{
+					JitOptimizer optimizer(e);optimizer.optimize();
+					unsigned comparisons=0;
+					for(auto* n=e.firstNode();n;n=n->next())
+						if(n->isInst() && n->as<asmjit::InstNode>()->id()==Inst::kIdCmp) ++comparisons;
+					// DCE can remove the intervening dead flag write in variant 5,
+					// exposing a valid opportunity on the next optimization pass.
+					if(comparisons!=((variant==0 || variant==5)?1u:2u)) throw std::string("Unexpected redundant comparison count");
+				}
+				e.finalize();if(m_rt.add(&funcs[optimized],&code)) throw std::string("Compare test JIT failed");
+			}
+			for(uint64_t input:{0ull,511ull,512ull,513ull,0xffffffffull,0x100000200ull})
+				if(funcs[0](input,7)!=funcs[1](input,7)) throw std::string("Redundant compare changed flags/result");
+			for(auto f:funcs) m_rt.release(f);
+		}
+#endif
+	}
