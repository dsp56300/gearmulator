@spritesheet nmm_button {
    up: 0px 0px 99px 47px;
    down: 0px 47px 99px 47px;
    src: button_black.png;
}
.panel-button { decorator: image(up fill); }
.panel-button:active, .panel-button:checked { decorator: image(down fill); }
.panel-knob { frames: 128; spriteprefix: knob_big_; }
#PatchNumber {
    background-color: #251520;
    color: #f43b49;
    font-family: DSEG7 Classic;
    font-size: 74dp;
    font-weight: bold;
    font-style: italic;
    text-align: center;
    line-height: 101dp;
}
#PanelStatus { color: #edc5c8; font-size: 18dp; text-align: right; }
