#!/usr/bin/make -f

# for DEB_HOST_GNU_TYPE, which names the cmake build dir
include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# VST2 builds against the bundled GPL-3.0 FST headers, not Steinberg's SDK.
override_dh_auto_configure:
	dh_auto_configure -- -Dgearmulator_BUILD_JUCEPLUGIN=ON -Dgearmulator_BUILD_JUCEPLUGIN_VST2=ON -Dgearmulator_BUILD_JUCEPLUGIN_VST3=ON -Dgearmulator_BUILD_JUCEPLUGIN_CLAP=ON -Dgearmulator_BUILD_JUCEPLUGIN_LV2=ON -Dgearmulator_BUILD_JUCEPLUGIN_Standalone=OFF

# One synth alone produced 378 MB of dbgsym; seven would be multiple GB per
# revision, and OBS disables debuginfo on the RPM side anyway. Drop this
# override to get -dbgsym packages back.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# The Virus integration and ROM hash tests need firmware we cannot ship.
# Call ctest directly: passing the regex through dh_auto_test's ARGS+= hands
# it to sh unquoted, and the parens and pipe are shell metacharacters there.
override_dh_auto_test:
	cd obj-$(DEB_HOST_GNU_TYPE) && ctest --output-on-failure --exclude-regex 'virusIntegrationTests|virusRomHashTests'

# Same whitelist as the spec: the tree's install rules are shaped for the CPack
# ZIPs, so a plain install also drops the vendored lunasvg, plutovg and RmlUi
# static libs, headers, cmake and pkgconfig files into the prefix, plus the
# test console and the bridge server plugin.
execute_after_dh_auto_install:
	find debian/theusualsuspects/usr -mindepth 1 -maxdepth 1 ! -name lib ! -name share -exec rm -rf {} +
	find debian/theusualsuspects/usr/lib -mindepth 1 -maxdepth 1 ! -name vst ! -name vst3 ! -name clap ! -name lv2 -exec rm -rf {} +
